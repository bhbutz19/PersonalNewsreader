{
  "version": 11,
  "rules": [
    {
      "name": "Urban Milwaukee",
      "source_id": "email_urban_milwaukee",
      "homepage": "https://urbanmilwaukee.com/",
      "subject_regex": "^Urban Milwaukee",
      "beat": "milwaukee",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 22
    },
    {
      "name": "WPR Wisconsin Today",
      "source_id": "email_wpr_wisconsin_today",
      "homepage": "https://www.wpr.org/news",
      "subject_regex": "^Wisconsin Today:",
      "beat": "wisconsin",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 12,
      "title_reject_regex": "(?i)^(read more from|according to|to learn more|from |listen to|support for|photo:|credit:|manage your preferences)"
    },
    {
      "name": "Wisconsin Watch Forward",
      "source_id": "email_wisconsin_watch",
      "homepage": "https://wisconsinwatch.org/",
      "subject_regex": "^(Forward:|The Act 10 saga)",
      "beat": "wisconsin_politics",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 12,
      "title_reject_regex": "(?i)^(read more from|according to|to learn more|from |photo:|credit:|manage your preferences|russian hackers sent|hackers tried|fbi identified)"
    },
    {
      "name": "Menorca Es Diari",
      "source_id": "email_menorca_esdiari",
      "homepage": "https://www.menorca.info/",
      "subject_regex": "^Las claves de Es Diari$",
      "beat": "menorca",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 10
    },
    {
      "name": "Eater DC",
      "source_id": "email_eater_dc",
      "homepage": "https://dc.eater.com/",
      "subject_regex": "(Eater DC|D\\.C\\.|new openings|best dishes)",
      "beat": "dc_dining",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 12,
      "title_reject_regex": "(?i)(Los Angeles|Manhattan|Portland, Oregon|OpenWeb|Download the app|Eater editors ate recently)"
    },
    {
      "name": "Washington Sun",
      "source_id": "email_washington_sun",
      "homepage": "https://www.washingtonsun.com/",
      "subject_regex": "(?i)(Washington Sun|What They’re Talking About|PAC Off|Final Countdown|Catch Up on .*Washington Sun|Afternoon Sun)",
      "beat": "us_politics",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 24,
      "title_reject_regex": "(?i)^(pic,? via|photo,? via|download the app|listen now|read more|view online|manage |follow |sign up|subscribe|presented by|browser view)|(^the sun.?s .+ reports$)",
      "notes": "Mixed Washington/National source. Match by Washington Sun sender/domain as well as known subjects; exclude account/promo mail. Default to us_politics and route clearly local stories into dc_local.",
      "beat_overrides": [
        {
          "beat": "dc_local",
          "title_regex": "(?i)(\\bD\\.C\\.\\b|\\bDC Council\\b|\\bDistrict of Columbia\\b|\\bWMATA\\b|\\bMetro\\b|\\bMPD\\b|\\bDCPS\\b|\\bANC\\b|\\bWard [1-8]\\b|\\bBowser\\b|\\bD\\.C\\. government\\b|\\bDistrict government\\b|\\bWashington neighborhood\\b|\\bDupont\\b|\\bShaw\\b|\\bGeorgetown\\b|\\bCapitol Hill\\b|\\bNavy Yard\\b|\\bAdams Morgan\\b|\\bColumbia Heights\\b|\\bPetworth\\b|\\bAnacostia\\b|\\bNoMa\\b)"
        }
      ],
      "sender_regex": "(?i)(washingtonsun|washsun)",
      "subject_exclude_regex": "(?i)(subscribe|welcome to the washington sun|code to log in|receipt|account|password)"
    },
    {
      "name": "Politico",
      "source_id": "email_politico",
      "homepage": "https://www.politico.com/",
      "subject_regex": "(SCOTUS|Obama returns|Buttigieg|DOJ subpoenas)",
      "beat": "us_politics",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 18,
      "title_reject_regex": "(?i)^(pic,? via|photo,? via|download the app|listen now|read more|view online|manage |follow |sign up)"
    },
    {
      "name": "Cooking",
      "source_id": "email_cooking",
      "homepage": "https://mail.google.com/",
      "subject_regex": "(recipes|favorite foods|Eater editors)",
      "beat": "cooking",
      "editorial_type": "newsletter",
      "extract_articles": false,
      "max_article_links": 10,
      "title_reject_regex": "(?i)(OpenWeb|Download the app|all the new openings in Portland)",
      "notes": "Temporarily disabled: generic Eater/cooking newsletters are producing restaurant-industry/navigation noise. Replace with dedicated cooking sources."
    },
    {
      "name": "J. Kenji López-Alt",
      "source_id": "kenji_newsletter",
      "homepage": "https://www.kenjilopezalt.com/",
      "subject_regex": "(?i)(Kenji|Alt-Weekly|Frienji)",
      "beat": "cooking",
      "editorial_type": "newsletter",
      "extract_articles": true,
      "max_article_links": 12,
      "must_carry": true,
      "title_reject_regex": "(?i)^(manage |unsubscribe|view in browser|shop|buy |gift |join )"
    },
    {
      "name": "Alton Brown",
      "source_id": "alton_brown_newsletter",
      "homepage": "https://altonbrown.com/",
      "subject_regex": "(?i)(Alton Brown|Good Eats|AB newsletter)",
      "beat": "cooking",
      "editorial_type": "newsletter",
      "extract_articles": true,
      "max_article_links": 12,
      "must_carry": true,
      "title_reject_regex": "(?i)^(manage |unsubscribe|view in browser|shop|merch|tour|buy )"
    },
    {
      "name": "America's Test Kitchen",
      "source_id": "atk_newsletter",
      "homepage": "https://www.americastestkitchen.com/",
      "subject_regex": "(?i)(America.?s Test Kitchen|Notes from the Test Kitchen|Cook.?s Illustrated|Cook.?s Country)",
      "beat": "cooking",
      "editorial_type": "newsletter",
      "extract_articles": true,
      "max_article_links": 15,
      "must_carry": true,
      "title_reject_regex": "(?i)^(manage |unsubscribe|view in browser|renew|subscribe|gift )"
    },
    {
      "name": "Kendra Vaculin — SCROUNGE",
      "source_id": "kendra_scrounge_email",
      "homepage": "https://scroungecooking.substack.com/",
      "subject_regex": "(?i)(SCROUNGE|Kendra Vaculin)",
      "beat": "cooking",
      "editorial_type": "newsletter",
      "extract_articles": true,
      "max_article_links": 10,
      "must_carry": true,
      "title_reject_regex": "(?i)^(manage |unsubscribe|view in browser|subscribe)"
    },
    {
      "name": "WAMU / DCist",
      "source_id": "wamu_dc",
      "homepage": "https://wamu.org/",
      "subject_regex": "(?i)(WAMU|DCist|WAMU Insider)",
      "beat": "dc_local",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 18,
      "title_reject_regex": "(?i)^(donate|support WAMU|manage |unsubscribe|view in browser|listen live|events?)"
    },
    {
      "name": "Not Bored in DC",
      "source_id": "not_bored_dc",
      "homepage": "https://newsletter.notboredindc.com/",
      "subject_regex": "(?i)(Not Bored in DC|Things to Do in DC)",
      "beat": "dc_local",
      "editorial_type": "newsletter",
      "extract_articles": true,
      "max_article_links": 14,
      "must_carry": true,
      "title_reject_regex": "(?i)^(subscribe|unsubscribe|manage |view in browser|forwarded this email)"
    },
    {
      "name": "Adams Morgan groups.io",
      "source_id": "adams_morgan_groups",
      "homepage": "https://groups.io/g/adamsmorgan",
      "subject_regex": "(?i)(\\[adamsmorgan\\]|adamsmorgan@groups\\.io|Adams Morgan)",
      "beat": "dc_local",
      "editorial_type": "social",
      "extract_articles": true,
      "max_article_links": 8,
      "title_reject_regex": "(?i)^(unsubscribe|manage |view in browser|groups\\.io)"
    },
    {
      "name": "Washingtonian",
      "source_id": "washingtonian_news",
      "homepage": "https://washingtonian.com/",
      "subject_regex": "(?i)(Washingtonian|News & Politics|The 100 Very Best|Things to Do|Washingtonian Today)",
      "beat": "dc_local",
      "editorial_type": "reported_news",
      "extract_articles": true,
      "max_article_links": 18,
      "title_reject_regex": "(?i)^(subscribe|unsubscribe|manage |view in browser|shop|advertise|events calendar|restaurants?)"
    }
  ],
  "link_filters": {
    "reject_text": [
      "unsubscribe",
      "manage preferences",
      "view in browser",
      "browser view",
      "subscribe",
      "sign up",
      "instagram",
      "facebook",
      "twitter",
      "x.com",
      "privacy",
      "contact us",
      "donate",
      "advertise",
      "newsletter"
    ],
    "reject_domains": [
      "google.com",
      "gmail.com",
      "facebook.com",
      "instagram.com",
      "twitter.com",
      "x.com",
      "linkedin.com"
    ],
    "min_title_length": 8
  }
}
